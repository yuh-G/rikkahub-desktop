0.85.1→1.0.3:上游把 Gemini 3 档位映射从 gga/vertex 两个局部辅助函数
(getThinkingLevel/getGemini3ThinkingLevel)收拢进 google-shared.ts 的
toGoogleThinkingLevel 单点,level 通道补丁随之移植到该唯一收敛点
(gga/vertex 两文件冲突区整体取上游,陈旧辅助块不再保留);
getGoogleBudget 回退表补键、ThinkingBudgets 扩键、
thinkingBudgetForLevel 精确键优先、resolveGoogleThinkingLevel 放行两档
——语义与 0.85.1 版补丁逐字节等价,hunk 因上游重构移位。

标记 10 处存活(git grep RIKKAHUB PATCH);宿主侧裸跑 tsc 前后对比
(去行列号)零新增诊断。
---
 packages/ai/src/api/google-generative-ai.ts |  9 +++++++++
 packages/ai/src/api/google-shared.ts        | 11 ++++++++++-
 packages/ai/src/api/google-vertex.ts        |  6 ++++++
 packages/ai/src/api/simple-options.ts       |  4 ++++
 packages/ai/src/types.ts                    |  5 +++++
 5 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/packages/ai/src/api/google-generative-ai.ts b/packages/ai/src/api/google-generative-ai.ts
index 24fe9134c..f4eed9ec9 100644
--- a/packages/ai/src/api/google-generative-ai.ts
+++ b/packages/ai/src/api/google-generative-ai.ts
@@ -443,6 +443,9 @@ function getGoogleBudget(
 			low: 2048,
 			medium: 8192,
 			high: 32768,
+			// [RIKKAHUB PATCH: budget-xhigh-max] 回退值取 high 同值(无注入时与原 clamp 行为一致)
+			xhigh: 32768,
+			max: 32768,
 		};
 		return budgets[level];
 	}
@@ -453,6 +456,9 @@ function getGoogleBudget(
 			low: 2048,
 			medium: 8192,
 			high: 24576,
+			// [RIKKAHUB PATCH: budget-xhigh-max]
+			xhigh: 24576,
+			max: 24576,
 		};
 		return budgets[level];
 	}
@@ -463,6 +469,9 @@ function getGoogleBudget(
 			low: 2048,
 			medium: 8192,
 			high: 24576,
+			// [RIKKAHUB PATCH: budget-xhigh-max]
+			xhigh: 24576,
+			max: 24576,
 		};
 		return budgets[level];
 	}
diff --git a/packages/ai/src/api/google-shared.ts b/packages/ai/src/api/google-shared.ts
index f546fbb00..38ff84ef7 100644
--- a/packages/ai/src/api/google-shared.ts
+++ b/packages/ai/src/api/google-shared.ts
@@ -34,7 +34,9 @@ type GoogleApiType = "google-generative-ai" | "google-vertex";
  * Mirrors Google's ThinkingLevel enum values.
  */
 export type GoogleApiThinkingLevel = "THINKING_LEVEL_UNSPECIFIED" | "MINIMAL" | "LOW" | "MEDIUM" | "HIGH";
-export type ResolvedGoogleThinkingLevel = Exclude<ThinkingLevel, "xhigh" | "max">;
+// [RIKKAHUB PATCH: budget-xhigh-max] 放开上两档:预算通道可查 xhigh/max 精确键,
+// level 通道(gemini-3 类)在各 getThinkingLevel 收拢为 HIGH。
+export type ResolvedGoogleThinkingLevel = ThinkingLevel;
 
 const GOOGLE_SDK_THINKING_LEVEL_MAP: Record<GoogleApiThinkingLevel, GoogleSdkThinkingLevel> = {
 	THINKING_LEVEL_UNSPECIFIED: GoogleSdkThinkingLevel.THINKING_LEVEL_UNSPECIFIED,
@@ -56,6 +58,9 @@ export function resolveGoogleThinkingLevel<T extends GoogleApiType>(
 		case "low":
 		case "medium":
 		case "high":
+		// [RIKKAHUB PATCH: budget-xhigh-max]
+		case "xhigh":
+		case "max":
 			return resolvedLevel;
 		default:
 			throw new Error(
@@ -91,6 +96,10 @@ export function toGoogleThinkingLevel(level: ResolvedGoogleThinkingLevel): Googl
 		case "medium":
 			return "MEDIUM";
 		case "high":
+		// [RIKKAHUB PATCH: budget-xhigh-max] 上游把 Gemini 3 的档位映射从
+		// gga/vertex 两个局部辅助函数收拢进本函数,补丁随之移植到这唯一收敛点。
+		case "xhigh":
+		case "max":
 			return "HIGH";
 	}
 }
diff --git a/packages/ai/src/api/google-vertex.ts b/packages/ai/src/api/google-vertex.ts
index 4e667df18..fa2fe2db6 100644
--- a/packages/ai/src/api/google-vertex.ts
+++ b/packages/ai/src/api/google-vertex.ts
@@ -536,6 +536,9 @@ function getGoogleBudget(
 			low: 2048,
 			medium: 8192,
 			high: 32768,
+			// [RIKKAHUB PATCH: budget-xhigh-max] 回退值取 high 同值(无注入时与原 clamp 行为一致)
+			xhigh: 32768,
+			max: 32768,
 		};
 		return budgets[level];
 	}
@@ -546,6 +549,9 @@ function getGoogleBudget(
 			low: 2048,
 			medium: 8192,
 			high: 24576,
+			// [RIKKAHUB PATCH: budget-xhigh-max]
+			xhigh: 24576,
+			max: 24576,
 		};
 		return budgets[level];
 	}
diff --git a/packages/ai/src/api/simple-options.ts b/packages/ai/src/api/simple-options.ts
index 7d287aa87..ef8198ca2 100644
--- a/packages/ai/src/api/simple-options.ts
+++ b/packages/ai/src/api/simple-options.ts
@@ -80,6 +80,10 @@ export function clampReasoning(effort: ThinkingLevel | undefined): Exclude<Think
 
 export function thinkingBudgetForLevel(reasoningLevel: ThinkingLevel, customBudgets?: ThinkingBudgets): number {
 	const budgets = { ...DEFAULT_THINKING_BUDGETS, ...customBudgets };
+	// [RIKKAHUB PATCH: budget-xhigh-max] 精确键优先:注入了 xhigh/max 预算时直取,
+	// 不再强制收拢 high;无精确键回退 clamp,与上游原版行为一致。
+	const exact = budgets[reasoningLevel as keyof ThinkingBudgets];
+	if (exact !== undefined) return exact;
 	const level = clampReasoning(reasoningLevel)!;
 	return budgets[level]!;
 }
diff --git a/packages/ai/src/types.ts b/packages/ai/src/types.ts
index 7469f3038..b67fad914 100644
--- a/packages/ai/src/types.ts
+++ b/packages/ai/src/types.ts
@@ -106,6 +106,11 @@ export interface ThinkingBudgets {
 	low?: number;
 	medium?: number;
 	high?: number;
+	// [RIKKAHUB PATCH: budget-xhigh-max] 上两档独立预算键:注入方(受控 settings)可为
+	// xhigh/max 提供与 high 不同的预算;未注入时各消费点回退 clamp(xhigh/max→high),
+	// 行为与上游原版一致。
+	xhigh?: number;
+	max?: number;
 }
 
 // Base options all providers share
