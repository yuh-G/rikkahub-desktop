diff --git a/packages/ai/src/api/simple-options.ts b/packages/ai/src/api/simple-options.ts
index 2a30265ad..c66dc78b7 100644
--- a/packages/ai/src/api/simple-options.ts
+++ b/packages/ai/src/api/simple-options.ts
@@ -67,6 +67,10 @@ export function clampReasoning(effort: ThinkingLevel | undefined): Exclude<Think
 
 export function thinkingBudgetForLevel(reasoningLevel: ThinkingLevel, customBudgets?: ThinkingBudgets): number {
 	const budgets = { ...DEFAULT_THINKING_BUDGETS, ...customBudgets };
+	// [RIKKAHUB PATCH: budget-xhigh-max] 精确键优先:注入了 xhigh/max 预算时直取,
+	// 不再强制收拢 high;无精确键回退 clamp,与上游原版行为一致。
+	const exact = budgets[reasoningLevel as keyof ThinkingBudgets];
+	if (exact !== undefined) return exact;
 	const level = clampReasoning(reasoningLevel)!;
 	return budgets[level]!;
 }
diff --git a/packages/ai/src/types.ts b/packages/ai/src/types.ts
index fe318fe42..23b19fdd9 100644
--- a/packages/ai/src/types.ts
+++ b/packages/ai/src/types.ts
@@ -102,6 +102,11 @@ export interface ThinkingBudgets {
 	low?: number;
 	medium?: number;
 	high?: number;
+	// [RIKKAHUB PATCH: budget-xhigh-max] 上两档独立预算键:注入方(受控 settings)可为
+	// xhigh/max 提供与 high 不同的预算;未注入时各消费点回退 clamp(xhigh/max→high),
+	// 行为与上游原版一致。
+	xhigh?: number;
+	max?: number;
 }
 
 // Base options all providers share
