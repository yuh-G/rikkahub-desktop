{
  "compilerOptions": {
    // target 对齐 pi 1.0.3 基线:pi 源码用 ES2024 的 v 正则标志(tui/utils.ts,非 lib
    // 语法是 target 门控)。宿主代码不依赖 ES2024 运行时差异,Bun 全量支持。
    "target": "ES2024",
    // lib 对齐 pi 1.0.3 基线:findLastIndex(ES2023,agent-session.ts)等内置方法需要
    // 对应 lib 声明。与 pi/tsconfig.base.json 的 ES2024 同源。
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 类型硬化收官(2026-07-24):noImplicitAny(5.4c) → strictNullChecks → strict 全开。
    // strict 蕴含 strictFunctionTypes/strictPropertyInitialization/useUnknownInCatchVariables 等,
    // 开启当日全仓零错误(前两档已消化绝大部分),此后不允许回退。
    "strict": true,
    // 0-1(2026-07-25):server.ts 曾积累 272 个死 import(历史大文件搬迁残留),typecheck
    // 不报导致新人无法从 import 判断真实依赖。大扫除清零后开启,此后不允许回退。
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    // vendored pi 包间引用走包名(exports 指向未构建的 dist/),运行时 Bun 吃 pi 自带
    // tsconfig paths,类型检查侧在此镜像同一映射直达源码(与 pi/tsconfig.json 保持一致)。
    "paths": {
      "@earendil-works/pi-ai": ["../pi/packages/ai/src/index.ts"],
      "@earendil-works/pi-ai/oauth": ["../pi/packages/ai/src/oauth.ts"],
      "@earendil-works/pi-ai/*": ["../pi/packages/ai/src/*.ts", "../pi/packages/ai/src/providers/*.ts"],
      "@earendil-works/pi-agent-core": ["../pi/packages/agent/src/index.ts"],
      "@earendil-works/pi-agent-core/*": ["../pi/packages/agent/src/*"],
      "@earendil-works/pi-coding-agent": ["../pi/packages/coding-agent/src/index.ts"],
      "@earendil-works/pi-coding-agent/*": ["../pi/packages/coding-agent/src/*"],
      "@earendil-works/pi-tui": ["../pi/packages/tui/src/index.ts"],
      "@earendil-works/pi-tui/*": ["../pi/packages/tui/src/*"],
      // pi 1.0.3 新增包:telemetry(ai/types.ts 顶层引用)、codemode/mcp(coding-agent
      // extensions 内部引用)。镜像 pi 根 tsconfig 的同名条目,带 ../pi/ 前缀。
      "@earendil-works/pi-telemetry": ["../pi/packages/telemetry/src/index.ts"],
      "@earendil-works/pi-telemetry/testing": ["../pi/packages/telemetry/src/testing/index.ts"],
      "@earendil-works/pi-codemode": ["../pi/packages/codemode/src/index.ts"],
      "@earendil-works/pi-codemode/declarations": ["../pi/packages/codemode/src/declarations.ts"],
      "@earendil-works/pi-codemode/source": ["../pi/packages/codemode/src/source.ts"],
      "@earendil-works/pi-codemode/worker": ["../pi/packages/codemode/src/runtime/worker.ts"],
      "@earendil-works/pi-mcp": ["../pi/packages/mcp/src/index.ts"],
      "@earendil-works/pi-mcp/oauth": ["../pi/packages/mcp/src/oauth/index.ts"],
      "@earendil-works/pi-mcp/testing": ["../pi/packages/mcp/src/testing/index.ts"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    // vendored pi 源码使用 .ts 后缀显式导入(其工程规范);我们 noEmit,此开关无发射风险。
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.ts", "scripts/**/*", "**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
